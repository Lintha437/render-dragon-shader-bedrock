// Native resource and stage-interface layouts for GamefaceClearQuad / vertex.
// RD_BINDING_LAYOUT is selected by the material build recipe.
layout(location = 9) in vec3 vertexPosition0;
layout(location = 12) in vec4 vertexTexCoord1;
#if RD_BINDING_LAYOUT == 0
layout(location = 15) in uvec4 vertexTexCoord4;
#endif
layout(location = 12) out vec4 varyingTexCoord1;
layout(location = 11) out vec4 varyingTexCoord0;
layout(location = 15) out vec4 varyingTexCoord4;
layout(location = 13) out vec3 varyingTexCoord2;
#if RD_BINDING_LAYOUT == 0
layout(location = 14) flat out vec4 varyingTexCoord3;
#elif RD_BINDING_LAYOUT == 1
layout(location = 14) out vec4 varyingTexCoord3;
#endif
layout(location = 16) out vec4 varyingTexCoord5;
