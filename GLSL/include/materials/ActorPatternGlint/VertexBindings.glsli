    vec4 packedValues[63];
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6
    vec4 packedValues[15];
#elif RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 12
    vec4 packedValues[62];
#elif RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 14
    vec4 packedValues[14];
#endif
} vertexVectorConstants0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 3
layout(location = 1) in int vertexBlendIndices0;
layout(location = 8) in vec3 vertexNormal0;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 5
layout(location = 2) in vec4 vertexColor0;
layout(location = 1) in int vertexBlendIndices0;
layout(location = 8) in vec4 vertexNormal0;
#elif RD_BINDING_LAYOUT == 4
layout(location = 1) in int vertexBlendIndices0;
#elif RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 8
layout(location = 2) in vec4 vertexColor0;
layout(location = 1) in int vertexBlendIndices0;
layout(location = 8) in vec3 vertexNormal0;
#elif RD_BINDING_LAYOUT == 9
layout(location = 2) in vec4 vertexColor0;
layout(location = 1) in int vertexBlendIndices0;
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 13
layout(location = 2) in vec4 vertexColor0;
#endif
layout(location = 9) in vec3 vertexPosition0;
layout(location = 11) in vec2 vertexTexCoord0;
#if RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 8
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#endif
layout(location = 3) out vec4 varyingColor1;
layout(location = 2) out vec4 varyingColor0;
layout(location = 4) out vec4 varyingColor2;
layout(location = 12) out vec4 varyingTexCoord1;
layout(location = 5) out vec4 varyingColor3;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 8 || RD_BINDING_LAYOUT == 9
layout(location = 11) out vec2 varyingTexCoord0;
layout(location = 13) out vec4 varyingTexCoord2;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 5
layout(location = 11) centroid out vec2 varyingTexCoord0;
layout(location = 13) centroid out vec4 varyingTexCoord2;
#endif
layout(location = 14) out vec3 varyingTexCoord3;
spirv_instruction(set = "GLSL.std.450", id = 81) float spvNClamp(float, float, float);
spirv_instruction(set = "GLSL.std.450", id = 81) vec2 spvNClamp(vec2, vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 81) vec3 spvNClamp(vec3, vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 81) vec4 spvNClamp(vec4, vec4, vec4);
