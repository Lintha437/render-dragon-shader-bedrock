// Native resource and stage-interface layouts for ActorMultiTexture / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[68];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 3
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[72];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 5
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[76];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 6
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[12];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 9
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[20];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 11
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[16];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 13
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[24];
} fragmentScalarConstants1;
#endif
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
{
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1
    vec4 packedValues[17];
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3
    vec4 packedValues[18];
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
    vec4 packedValues[19];
#elif RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[3];
#elif RD_BINDING_LAYOUT == 8 || RD_BINDING_LAYOUT == 9
    vec4 packedValues[5];
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 11
    vec4 packedValues[4];
#elif RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 13
    vec4 packedValues[6];
#endif
} fragmentVectorConstants1;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5
layout(set = 0, binding = 0) uniform texture2D materialTexture0;
layout(set = 0, binding = 1) uniform texture2D materialTexture1;
layout(set = 0, binding = 2) uniform texture2D materialTexture2;
layout(set = 0, binding = 0) uniform sampler textureSampler0;
layout(set = 0, binding = 1) uniform sampler textureSampler1;
layout(set = 0, binding = 2) uniform sampler textureSampler2;
layout(location = 3) in vec4 varyingColor1;
layout(location = 2) in vec3 varyingColor0;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 8
layout(set = 0, binding = 0) uniform texture2D matTextureTexture;
layout(set = 0, binding = 1) uniform texture2D matTexture1Texture;
layout(set = 0, binding = 2) uniform texture2D matTexture2Texture;
layout(set = 0, binding = 0) uniform sampler matTextureSampler;
layout(set = 0, binding = 1) uniform sampler matTexture1Sampler;
layout(set = 0, binding = 2) uniform sampler matTexture2Sampler;
layout(location = 3) in vec4 varyingColor1;
layout(location = 2) in vec4 varyingColor0;
#elif RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 9
layout(set = 0, binding = 0) uniform texture2D materialTexture0;
layout(set = 0, binding = 1) uniform texture2D materialTexture1;
layout(set = 0, binding = 2) uniform texture2D materialTexture2;
layout(set = 0, binding = 0) uniform sampler textureSampler0;
layout(set = 0, binding = 1) uniform sampler textureSampler1;
layout(set = 0, binding = 2) uniform sampler textureSampler2;
layout(location = 2) in vec3 varyingColor0;
#endif
layout(location = 4) in vec4 varyingColor2;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 9
layout(location = 5) in vec3 varyingColor3;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 8
layout(location = 5) in vec4 varyingColor3;
#endif
layout(location = 11) centroid in vec2 varyingTexCoord0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 8
layout(location = 14) in vec3 varyingTexCoord3;
#endif
layout(location = 0) out vec4 fragmentColor0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
#include "../../FragmentControl.glsli"
#endif
spirv_instruction(set = "GLSL.std.450", id = 80) float spvNMax(float, float);
spirv_instruction(set = "GLSL.std.450", id = 80) vec2 spvNMax(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 80) vec3 spvNMax(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 80) vec4 spvNMax(vec4, vec4);
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
spirv_instruction(set = "GLSL.std.450", id = 81) float spvNClamp(float, float, float);
spirv_instruction(set = "GLSL.std.450", id = 81) vec2 spvNClamp(vec2, vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 81) vec3 spvNClamp(vec3, vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 81) vec4 spvNClamp(vec4, vec4, vec4);
#endif
