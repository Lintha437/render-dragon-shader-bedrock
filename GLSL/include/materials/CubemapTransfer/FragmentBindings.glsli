// Native resource and stage-interface layouts for CubemapTransfer / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
#elif RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
#endif
{
#if RD_BINDING_LAYOUT == 0
    vec4 packedValues[2];
} fragmentVectorConstants1;
layout(set = 0, binding = 0) uniform textureCube srcTextureCubeTexture;
layout(set = 0, binding = 0) uniform sampler srcTextureCubeSampler;
#elif RD_BINDING_LAYOUT == 1
    float packedValues[8];
} fragmentScalarConstants1;
layout(set = 0, binding = 0) uniform textureCube materialTexture0;
layout(set = 0, binding = 0) uniform sampler textureSampler0;
#endif
layout(location = 11) in vec2 varyingTexCoord0;
layout(location = 0) out vec4 fragmentColor0;
