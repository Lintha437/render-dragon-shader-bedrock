// Native resource and stage-interface layouts for ScreenUV / vertex.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0
layout(location = 9) in vec2 vertexPosition0;
#elif RD_BINDING_LAYOUT == 1
layout(location = 9) in vec3 vertexPosition0;
#endif
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 2) out vec4 varyingColor0;
