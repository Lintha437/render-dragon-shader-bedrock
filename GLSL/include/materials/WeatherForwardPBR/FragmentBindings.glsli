layout(set = 0, binding = 2) uniform sampler textureSampler2;
layout(set = 0, binding = 4) uniform sampler textureSampler4;
layout(set = 0, binding = 5) uniform sampler textureSampler5;
layout(set = 0, binding = 7) uniform sampler textureSampler7;
layout(location = 4) in vec3 varyingColor2;
layout(location = 13) in float varyingTexCoord2;
layout(location = 12) in vec2 varyingTexCoord1;
#elif RD_BINDING_LAYOUT == 1
    vec4 packedValues[55];
} fragmentVectorConstants1;
