layout(set = 0, binding = 4) uniform texture2D previousFrameAverageLuminanceTexture;
layout(set = 0, binding = 5) uniform texture2D weatherTextureTexture;
layout(set = 0, binding = 7) uniform texture2DArray scatteringBufferTexture;
layout(set = 0, binding = 2) uniform sampler occlusionTextureSampler;
layout(set = 0, binding = 4) uniform sampler previousFrameAverageLuminanceSampler;
layout(set = 0, binding = 5) uniform sampler weatherTextureSampler;
layout(set = 0, binding = 7) uniform sampler scatteringBufferSampler;
