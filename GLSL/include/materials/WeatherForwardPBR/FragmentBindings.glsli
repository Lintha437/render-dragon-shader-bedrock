layout(location = 4) in vec3 varyingColor2;
layout(location = 13) in float varyingTexCoord2;
layout(location = 12) in vec2 varyingTexCoord1;
#elif RD_BINDING_LAYOUT == 2
    vec4 packedValues[54];
} fragmentVectorConstants1;
