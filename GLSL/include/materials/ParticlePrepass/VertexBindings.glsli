// Native resource and stage-interface layouts for ParticlePrepass / vertex.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[88];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 3
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[24];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 7
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[108];
} vertexScalarConstants0;
#endif
layout(set = 0, binding = 0, std140) uniform VertexVectorConstants0Buffer
{
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1
    vec4 packedValues[22];
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3
    vec4 packedValues[6];
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[27];
#endif
} vertexVectorConstants0;
layout(location = 2) in vec4 vertexColor0;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6
layout(location = 8) in vec4 vertexNormal0;
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 7
layout(location = 8) in vec3 vertexNormal0;
#endif
layout(location = 9) in vec3 vertexPosition0;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
layout(location = 10) in vec4 vertexTangent0;
#endif
layout(location = 11) in vec2 vertexTexCoord0;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
layout(location = 12) in vec2 vertexTexCoord1;
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
layout(location = 12) in vec2 vertexTexCoord1;
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#elif RD_BINDING_LAYOUT == 3
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#endif
layout(location = 0) out vec3 varyingBitangent0;
layout(location = 2) out vec4 varyingColor0;
layout(location = 13) out vec3 varyingTexCoord2;
layout(location = 3) out vec4 varyingColor1;
layout(location = 8) out vec3 varyingNormal0;
layout(location = 15) out vec3 varyingTexCoord4;
layout(location = 10) out vec3 varyingTangent0;
layout(location = 11) out vec2 varyingTexCoord0;
layout(location = 12) out vec2 varyingTexCoord1;
layout(location = 14) out vec3 varyingTexCoord3;
spirv_instruction(set = "GLSL.std.450", id = 81) float spvNClamp(float, float, float);
spirv_instruction(set = "GLSL.std.450", id = 81) vec2 spvNClamp(vec2, vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 81) vec3 spvNClamp(vec3, vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 81) vec4 spvNClamp(vec4, vec4, vec4);
