// Native resource and stage-interface layouts for DeferredIndirectSpecular / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
{
    vec4 packedValues[38];
} fragmentVectorConstants1;
layout(set = 0, binding = 0) uniform texture2D brdfLutTexture;
layout(set = 0, binding = 1) uniform texture2D colorMetalnessSubsurfaceTexture;
layout(set = 0, binding = 2) uniform utexture2D emissiveAmbientLinearRoughnessTexture;
layout(set = 0, binding = 3) uniform texture2D normalTexture;
layout(set = 0, binding = 6) uniform texture2D previousFrameAverageLuminanceTexture;
layout(set = 0, binding = 7) uniform texture2D ssrTextureTexture;
layout(set = 0, binding = 8) uniform texture2D sceneDepthTexture;
layout(set = 0, binding = 10) uniform texture2DArray scatteringBufferTexture;
layout(set = 0, binding = 12) uniform textureCubeArray specularIblRecordsTexture;
layout(set = 0, binding = 0) uniform sampler brdfLutSampler;
layout(set = 0, binding = 1) uniform sampler colorMetalnessSubsurfaceSampler;
layout(set = 0, binding = 3) uniform sampler normalSampler;
layout(set = 0, binding = 6) uniform sampler previousFrameAverageLuminanceSampler;
layout(set = 0, binding = 7) uniform sampler ssrTextureSampler;
layout(set = 0, binding = 8) uniform sampler sceneDepthSampler;
layout(set = 0, binding = 10) uniform sampler scatteringBufferSampler;
layout(set = 0, binding = 12) uniform sampler specularIblRecordsSampler;
layout(location = 3) in vec3 varyingColor1;
layout(location = 11) in vec4 varyingTexCoord0;
