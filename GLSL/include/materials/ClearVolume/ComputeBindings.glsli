// Native resource and stage-interface layouts for ClearVolume / compute.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1
layout(local_size_x = 8, local_size_y = 8, local_size_z = 2) in;
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
#endif
layout(set = 0, binding = 0, std140) uniform ComputeVectorConstants0Buffer
{
    vec4 packedValues[2];
} computeVectorConstants0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 5
layout(set = 0, binding = 0) uniform writeonly image2DArray intermediateValue;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4
layout(set = 0, binding = 0) uniform writeonly image2DArray volumeTexture;
#endif
