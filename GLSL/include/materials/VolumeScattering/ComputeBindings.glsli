// Native resource and stage-interface layouts for VolumeScattering / compute.
// RD_BINDING_LAYOUT is selected by the material build recipe.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#if RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 0, scalar) uniform ComputeScalarConstants0Buffer
{
    float packedValues[8];
} computeScalarConstants0;
#endif
layout(set = 0, binding = 0, std140) uniform ComputeVectorConstants0Buffer
{
    vec4 packedValues[2];
} computeVectorConstants0;
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 0) uniform texture2DArray scatteringBufferInTexture;
layout(set = 0, binding = 1) uniform writeonly image2DArray scatteringBufferOutTexture;
#elif RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 0) uniform texture2DArray materialTexture0;
layout(set = 0, binding = 1) uniform writeonly image2DArray intermediateValue1;
#endif
