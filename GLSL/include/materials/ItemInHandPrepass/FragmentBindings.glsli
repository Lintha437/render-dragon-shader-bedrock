// Native resource and stage-interface layouts for ItemInHandPrepass / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[56];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 3
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[60];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 5
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[108];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 7
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[112];
} fragmentScalarConstants1;
#endif
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
{
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1
    vec4 packedValues[14];
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3
    vec4 packedValues[15];
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
    vec4 packedValues[27];
#elif RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[28];
#endif
} fragmentVectorConstants1;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
layout(location = 0) in vec3 varyingBitangent0;
layout(location = 3) in vec4 varyingColor1;
layout(location = 2) in vec4 varyingColor0;
#elif RD_BINDING_LAYOUT == 1
layout(location = 2) in vec4 varyingColor0;
#elif RD_BINDING_LAYOUT == 3
layout(location = 2) in vec2 varyingColor0;
#elif RD_BINDING_LAYOUT == 5
layout(location = 3) in vec4 varyingColor1;
layout(location = 2) in vec4 varyingColor0;
#elif RD_BINDING_LAYOUT == 7
layout(location = 3) in vec4 varyingColor1;
layout(location = 2) in vec2 varyingColor0;
#endif
layout(location = 19) in vec4 varyingTexCoord8;
layout(location = 8) in vec3 varyingNormal0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
layout(location = 15) flat in int varyingTexCoord4;
#endif
layout(location = 16) in vec3 varyingTexCoord5;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
layout(location = 10) in vec3 varyingTangent0;
layout(location = 11) in vec2 varyingTexCoord0;
#endif
layout(location = 14) in vec3 varyingTexCoord3;
layout(location = 0) out uvec4 fragmentColor0;
layout(location = 1) out vec4 fragmentColor1;
layout(location = 2) out vec4 fragmentColor2;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 3
spirv_instruction(set = "GLSL.std.450", id = 79) float spvNMin(float, float);
spirv_instruction(set = "GLSL.std.450", id = 79) vec2 spvNMin(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 79) vec3 spvNMin(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 79) vec4 spvNMin(vec4, vec4);
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
