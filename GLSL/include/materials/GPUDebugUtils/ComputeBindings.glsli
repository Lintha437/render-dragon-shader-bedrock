// Native resource and stage-interface layouts for GPUDebugUtils / compute.
// RD_BINDING_LAYOUT is selected by the material build recipe.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 0) uniform writeonly iimageBuffer intermediateValue;
#elif RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 0) uniform writeonly iimageBuffer fakeRwBuffer;
#elif RD_BINDING_LAYOUT == 2
layout(set = 0, binding = 0, r32i) uniform iimageBuffer intermediateValue;
#elif RD_BINDING_LAYOUT == 3
layout(set = 0, binding = 0, r32i) uniform iimageBuffer fakeRwBuffer;
#endif
