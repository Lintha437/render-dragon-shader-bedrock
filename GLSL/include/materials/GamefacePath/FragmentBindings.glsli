// Native resource and stage-interface layouts for GamefacePath / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[16384];
} fragmentScalarConstants1;
#endif
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
{
#if RD_BINDING_LAYOUT == 0
    vec4 packedValues[128];
#elif RD_BINDING_LAYOUT == 1
    vec4 packedValues[4096];
#endif
} fragmentVectorConstants1;
#if RD_BINDING_LAYOUT == 0
layout(location = 11) in vec4 varyingTexCoord0;
#elif RD_BINDING_LAYOUT == 1
layout(location = 11) in vec2 varyingTexCoord0;
#endif
layout(location = 14) flat in vec4 varyingTexCoord3;
layout(location = 0) out vec4 fragmentColor0;
spirv_instruction(set = "GLSL.std.450", id = 79) float spvNMin(float, float);
spirv_instruction(set = "GLSL.std.450", id = 79) vec2 spvNMin(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 79) vec3 spvNMin(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 79) vec4 spvNMin(vec4, vec4);
#if RD_BINDING_LAYOUT == 0
spirv_instruction(set = "GLSL.std.450", id = 81) float spvNClamp(float, float, float);
spirv_instruction(set = "GLSL.std.450", id = 81) vec2 spvNClamp(vec2, vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 81) vec3 spvNClamp(vec3, vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 81) vec4 spvNClamp(vec4, vec4, vec4);
#elif RD_BINDING_LAYOUT == 1
spirv_instruction(set = "GLSL.std.450", id = 80) float spvNMax(float, float);
spirv_instruction(set = "GLSL.std.450", id = 80) vec2 spvNMax(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 80) vec3 spvNMax(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 80) vec4 spvNMax(vec4, vec4);
#endif
