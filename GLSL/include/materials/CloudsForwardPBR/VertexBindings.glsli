// Native resource and stage-interface layouts for CloudsForwardPBR / vertex.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 1
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[108];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 2
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[44];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 8
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[116];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 11
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[52];
} vertexScalarConstants0;
#endif
layout(set = 0, binding = 0, std140) uniform VertexVectorConstants0Buffer
{
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1
    vec4 packedValues[27];
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3
    vec4 packedValues[11];
#elif RD_BINDING_LAYOUT == 4
    vec4 packedValues[8];
#elif RD_BINDING_LAYOUT == 5
    vec4 packedValues[20];
#elif RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[4];
#elif RD_BINDING_LAYOUT == 8 || RD_BINDING_LAYOUT == 9
    vec4 packedValues[29];
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 11
    vec4 packedValues[13];
#endif
} vertexVectorConstants0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7 || RD_BINDING_LAYOUT == 9
layout(location = 2) in vec4 vertexColor0;
layout(location = 8) in vec4 vertexNormal0;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2
layout(location = 2) in vec3 vertexColor0;
layout(location = 8) in vec3 vertexNormal0;
#endif
layout(location = 9) in vec3 vertexPosition0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 9
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
layout(location = 15) flat out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 1
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
layout(location = 15) out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 2
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
layout(location = 15) out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 7
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
layout(location = 15) flat out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 8
layout(location = 15) out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 6
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
layout(location = 15) out int varyingTexCoord4;
#endif
layout(location = 2) out vec4 varyingColor0;
layout(location = 6) out vec4 varyingFragmentPosition0;
layout(location = 8) out vec3 varyingNormal0;
#if RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 8 || RD_BINDING_LAYOUT == 9
layout(location = 17) out vec3 varyingTexCoord6;
#endif
layout(location = 11) out vec2 varyingTexCoord0;
layout(location = 16) out vec2 varyingTexCoord5;
layout(location = 14) out vec3 varyingTexCoord3;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
spirv_instruction(set = "GLSL.std.450", id = 81) float spvNClamp(float, float, float);
spirv_instruction(set = "GLSL.std.450", id = 81) vec2 spvNClamp(vec2, vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 81) vec3 spvNClamp(vec3, vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 81) vec4 spvNClamp(vec4, vec4, vec4);
#elif RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7
spirv_instruction(set = "GLSL.std.450", id = 79) float spvNMin(float, float);
spirv_instruction(set = "GLSL.std.450", id = 79) vec2 spvNMin(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 79) vec3 spvNMin(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 79) vec4 spvNMin(vec4, vec4);
spirv_instruction(set = "GLSL.std.450", id = 80) float spvNMax(float, float);
spirv_instruction(set = "GLSL.std.450", id = 80) vec2 spvNMax(vec2, vec2);
spirv_instruction(set = "GLSL.std.450", id = 80) vec3 spvNMax(vec3, vec3);
spirv_instruction(set = "GLSL.std.450", id = 80) vec4 spvNMax(vec4, vec4);
#endif
