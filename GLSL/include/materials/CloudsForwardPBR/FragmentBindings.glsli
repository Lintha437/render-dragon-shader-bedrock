// Native resource and stage-interface layouts for CloudsForwardPBR / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[176];
} fragmentScalarConstants1;
layout(set = 0, binding = 1, std140) uniform FragmentVectorConstants1Buffer
{
    vec4 packedValues[44];
} fragmentVectorConstants1;
layout(set = 0, binding = 0) uniform texture2D materialTexture0;
layout(set = 0, binding = 1) uniform texture2D materialTexture1;
layout(set = 0, binding = 3) uniform texture2DArray materialTexture3;
layout(set = 0, binding = 5) uniform texture3D materialTexture5;
layout(set = 0, binding = 6) uniform textureCubeArray materialTexture6;
layout(set = 0, binding = 0) uniform sampler textureSampler0;
layout(set = 0, binding = 1) uniform sampler textureSampler1;
layout(set = 0, binding = 3) uniform sampler textureSampler3;
layout(set = 0, binding = 5) uniform sampler textureSampler5;
layout(set = 0, binding = 6) uniform sampler textureSampler6;
layout(location = 15) flat in int varyingTexCoord4;
layout(location = 2) in vec4 varyingColor0;
layout(location = 8) in vec3 varyingNormal0;
layout(location = 16) in vec2 varyingTexCoord5;
layout(location = 14) in vec3 varyingTexCoord3;
#elif RD_BINDING_LAYOUT == 1
float intermediateValue12;
