// Native resource and stage-interface layouts for SingleBlockPrepass / vertex.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 16
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[100];
} vertexScalarConstants0;
#elif RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 19
layout(set = 0, binding = 0, scalar) uniform VertexScalarConstants0Buffer
{
    float packedValues[104];
} vertexScalarConstants0;
#endif
layout(set = 0, binding = 0, std140) uniform VertexVectorConstants0Buffer
{
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 8
    vec4 packedValues[8];
#elif RD_BINDING_LAYOUT == 1
    vec4 packedValues[20];
#elif RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 9
    vec4 packedValues[21];
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 5
    vec4 packedValues[4];
#elif RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[5];
#elif RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 16 || RD_BINDING_LAYOUT == 17
    vec4 packedValues[25];
#elif RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 18 || RD_BINDING_LAYOUT == 19
    vec4 packedValues[26];
#endif
} vertexVectorConstants0;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 17 || RD_BINDING_LAYOUT == 18 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7
layout(location = 2) in vec4 vertexColor0;
layout(location = 8) in vec4 vertexNormal0;
#elif RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 9
layout(location = 2) in vec3 vertexColor0;
#elif RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 16
layout(location = 2) in vec4 vertexColor0;
layout(location = 8) in vec3 vertexNormal0;
#elif RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 19
layout(location = 2) in vec3 vertexColor0;
layout(location = 8) in vec3 vertexNormal0;
#endif
layout(location = 9) in vec3 vertexPosition0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 2
layout(location = 11) in vec2 vertexTexCoord0;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 3
layout(location = 10) in vec4 vertexTangent0;
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
#elif RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#elif RD_BINDING_LAYOUT == 16 || RD_BINDING_LAYOUT == 17 || RD_BINDING_LAYOUT == 18 || RD_BINDING_LAYOUT == 19 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7
layout(location = 10) in vec4 vertexTangent0;
layout(location = 11) in vec2 vertexTexCoord0;
layout(location = 15) in int vertexTexCoord4;
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#elif RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 11
layout(location = 18) in vec4 vertexTexCoord7;
layout(location = 17) in vec4 vertexTexCoord6;
layout(location = 16) in vec4 vertexTexCoord5;
#endif
layout(location = 0) out vec3 varyingBitangent0;
layout(location = 3) out vec4 varyingColor1;
layout(location = 2) out vec4 varyingColor0;
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 11 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 16 || RD_BINDING_LAYOUT == 19 || RD_BINDING_LAYOUT == 2 || RD_BINDING_LAYOUT == 4 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 8 || RD_BINDING_LAYOUT == 9
layout(location = 7) out int varyingFrontFacing0;
layout(location = 15) out int varyingTexCoord4;
#elif RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 17 || RD_BINDING_LAYOUT == 18 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7
layout(location = 7) flat out int varyingFrontFacing0;
#endif
layout(location = 8) out vec3 varyingNormal0;
#if RD_BINDING_LAYOUT == 1 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 17 || RD_BINDING_LAYOUT == 18 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5 || RD_BINDING_LAYOUT == 7
layout(location = 15) flat out int varyingTexCoord4;
#endif
layout(location = 16) out vec3 varyingTexCoord5;
layout(location = 10) out vec3 varyingTangent0;
layout(location = 11) out vec2 varyingTexCoord0;
layout(location = 14) out vec3 varyingTexCoord3;
