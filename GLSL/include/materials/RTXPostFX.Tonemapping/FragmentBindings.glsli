layout(set = 0, binding = 2) uniform sampler gRasterizedInputSampler;
layout(set = 0, binding = 3) uniform sampler gToneCurveSampler;
#endif
layout(location = 11) in vec2 varyingTexCoord0;
layout(location = 0) out vec4 fragmentColor0;
