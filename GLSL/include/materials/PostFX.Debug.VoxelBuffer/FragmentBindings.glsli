    uvec4 packedValues[];
} intermediateValue2;
layout(set = 0, binding = 7, std430) restrict readonly buffer intermediateValue25
{
    uint packedValues[];
} intermediateValue3;
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[44];
} fragmentScalarConstants1;
