    vec4 packedValues[2];
#elif RD_BINDING_LAYOUT == 14 || RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 6 || RD_BINDING_LAYOUT == 7
    vec4 packedValues[9];
#endif
} fragmentVectorConstants1;
