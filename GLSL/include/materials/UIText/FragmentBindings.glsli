// Native resource and stage-interface layouts for UIText / fragment.
// RD_BINDING_LAYOUT is selected by the material build recipe.
#if RD_BINDING_LAYOUT == 0 || RD_BINDING_LAYOUT == 10 || RD_BINDING_LAYOUT == 12 || RD_BINDING_LAYOUT == 13 || RD_BINDING_LAYOUT == 3 || RD_BINDING_LAYOUT == 5
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[8];
} fragmentScalarConstants1;
#elif RD_BINDING_LAYOUT == 15 || RD_BINDING_LAYOUT == 7
layout(set = 0, binding = 1, scalar) uniform FragmentScalarConstants1Buffer
{
    float packedValues[36];
} fragmentScalarConstants1;
#endif
