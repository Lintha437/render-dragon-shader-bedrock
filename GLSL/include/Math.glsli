// Shared arithmetic and texture-query helpers.
// Each selected overload preserves the recovered operation order and precision.
#if defined(RD_USE_DOT4_PRECISE_FLOAT_0)
float rdDot4Precise(vec4 leftVector, vec4 rightVector);
#endif
#if defined(RD_USE_DOT3_PRECISE_FLOAT_1)
float rdDot3Precise(vec3 leftVector, vec3 rightVector);
#endif
#if defined(RD_USE_DOT4_PRECISE2_FLOAT_2)
float rdDot4Precise2(vec4 leftVector, vec4 rightVector);
#endif
#if defined(RD_USE_DOT3_PRECISE2_FLOAT_3)
float rdDot3Precise2(vec3 leftVector, vec3 rightVector);
#endif
#if defined(RD_USE_EVALUATE_FLOAT_EXPRESSION_FLOAT_4)
float rdEvaluateFloatExpression(uint sourceValue);
#endif
#if defined(RD_USE_DOT2_PRECISE_FLOAT_5)
float rdDot2Precise(vec2 leftVector, vec2 rightVector);
#endif
#if defined(RD_USE_SIGNED_BITS_TO_FLOAT_FLOAT_6)
float rdSignedBitsToFloat(uint sourceValue);
#endif
#if defined(RD_USE_EVALUATE_FLOAT_EXPRESSION2_FLOAT_7)
float rdEvaluateFloatExpression2(uint sourceValue);
#endif
#if defined(RD_USE_DOT2_PRECISE2_FLOAT_8)
float rdDot2Precise2(vec2 leftVector, vec2 rightVector);
#endif
#if defined(RD_USE_SIGNED_BITS_TO_FLOAT2_FLOAT_9)
float rdSignedBitsToFloat2(uint sourceValue);
#endif
#if defined(RD_USE_MODULO_UNSIGNED_UINT_10)
uint rdModuloUnsigned(uint numerator, uint denominator);
#endif
#if defined(RD_USE_DIVIDE_UNSIGNED_UINT_11)
uint rdDivideUnsigned(uint numerator, uint denominator);
#endif
#if defined(RD_USE_UNSIGNED_DIV_MOD_UVEC2_12)
uvec2 rdUnsignedDivMod(uint argument0, uint argument1);
#endif

#if defined(RD_USE_DOT4_PRECISE_FLOAT_0)
float rdDot4Precise(vec4 leftVector, vec4 rightVector)
{
    precise float productValue = leftVector.x * rightVector.x;
    return fma(leftVector.w, rightVector.w, fma(leftVector.z, rightVector.z, fma(leftVector.y, rightVector.y, productValue)));
}
#endif

#if defined(RD_USE_DOT3_PRECISE_FLOAT_1)
float rdDot3Precise(vec3 leftVector, vec3 rightVector)
{
    precise float productValue = leftVector.x * rightVector.x;
    discardIfRequested();
    return fma(leftVector.z, rightVector.z, fma(leftVector.y, rightVector.y, productValue));
}
#endif

#if defined(RD_USE_DOT4_PRECISE2_FLOAT_2)
float rdDot4Precise2(vec4 leftVector, vec4 rightVector)
{
    precise float productValue = leftVector.x * rightVector.x;
    discardIfRequested();
    return fma(leftVector.w, rightVector.w, fma(leftVector.z, rightVector.z, fma(leftVector.y, rightVector.y, productValue)));
}
#endif

#if defined(RD_USE_DOT3_PRECISE2_FLOAT_3)
float rdDot3Precise2(vec3 leftVector, vec3 rightVector)
{
    precise float productValue = leftVector.x * rightVector.x;
    return fma(leftVector.z, rightVector.z, fma(leftVector.y, rightVector.y, productValue));
}
#endif

#if defined(RD_USE_EVALUATE_FLOAT_EXPRESSION_FLOAT_4)
float rdEvaluateFloatExpression(uint sourceValue)
{
    return float(uint64_t(sourceValue));
}
#endif

#if defined(RD_USE_DOT2_PRECISE_FLOAT_5)
float rdDot2Precise(vec2 leftVector, vec2 rightVector)
{
    precise float productValue1 = leftVector.x * rightVector.x;
    return fma(leftVector.y, rightVector.y, productValue1);
}
#endif

#if defined(RD_USE_SIGNED_BITS_TO_FLOAT_FLOAT_6)
float rdSignedBitsToFloat(uint sourceValue)
{
    return float(int(sourceValue));
}
#endif

#if defined(RD_USE_EVALUATE_FLOAT_EXPRESSION2_FLOAT_7)
float rdEvaluateFloatExpression2(uint sourceValue)
{
    discardIfRequested();
    return float(uint64_t(sourceValue));
}
#endif

#if defined(RD_USE_DOT2_PRECISE2_FLOAT_8)
float rdDot2Precise2(vec2 leftVector, vec2 rightVector)
{
    precise float productValue1 = leftVector.x * rightVector.x;
    discardIfRequested();
    return fma(leftVector.y, rightVector.y, productValue1);
}
#endif

#if defined(RD_USE_SIGNED_BITS_TO_FLOAT2_FLOAT_9)
float rdSignedBitsToFloat2(uint sourceValue)
{
    discardIfRequested();
    return float(int(sourceValue));
}
#endif

#if defined(RD_USE_MODULO_UNSIGNED_UINT_10)
uint rdModuloUnsigned(uint numerator, uint denominator)
{
    uint resultValue;
    SPIRV_CROSS_FLATTEN
    if (denominator == 0u)
    {
        resultValue = 4294967295u;
    }
    else
    {
        resultValue = numerator % denominator;
    }
    return resultValue;
}
#endif

#if defined(RD_USE_DIVIDE_UNSIGNED_UINT_11)
uint rdDivideUnsigned(uint numerator, uint denominator)
{
    uint resultValue;
    SPIRV_CROSS_FLATTEN
    if (denominator == 0u)
    {
        resultValue = 4294967295u;
    }
    else
    {
        resultValue = numerator / denominator;
    }
    return resultValue;
}
#endif

#if defined(RD_USE_UNSIGNED_DIV_MOD_UVEC2_12)
uvec2 rdUnsignedDivMod(uint argument0, uint argument1)
{
    if (argument1 != 0u)
    {
        return uvec2(rdDivideUnsigned(argument0, argument1), rdModuloUnsigned(argument0, argument1));
    }
    else
    {
        return uvec2(4294967295u);
    }
}
#endif
